{
  "name": "daiyanmozumder/snaptrip",
  "description": "A Laravel package for resizing, compressing, watermarking, and converting images to WebP using Python.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Daiyan Mozumder",
      "email": "daiyan1091@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "DaiyanMozumder\\SnapTrip\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DaiyanMozumder\\SnapTrip\\SnapTripServiceProvider"
      ],
      "aliases": {
        "SnapTrip": "DaiyanMozumder\\SnapTrip\\Facades\\SnapTrip"
      }
    }
  },
  "minimum-stability": "stable"
}
